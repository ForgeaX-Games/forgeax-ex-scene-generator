{
  "schemaVersion": 2,
  "id": "@forgeax-plugin/wb-scene-generator",
  "version": "0.2.5",
  "displayName": {
    "zh": "场景生成器",
    "en": "Scene Generator"
  },
  "description": {
    "zh": "由 Sino 负责的完整场景设计工作台。适用于城市、关卡、地形、道路、街区、动线、空间布局、可玩区域与场景丰富度迭代；以 Scene Script 为创作真值、节点图为同步可视化投影。完整场景请求应派给 sino；只有明确要求独立可复用 .glb 模型资产时才改派 lowpoly。",
    "en": "Sino's complete scene-design workbench for cities, levels, terrain, roads, districts, circulation, spatial layout, playable areas, and iterative scene enrichment. Scene Script is the authoring truth and the node graph its synchronized visual projection. Dispatch complete-scene requests to sino; use lowpoly only for explicitly requested standalone reusable .glb model assets."
  },
  "icon": "🌍",
  "compatibleWith": {
    "forgeax-node-runtime": "^0.3.0"
  },
  "requestedEnv": [
    "FORGEAX_PLUGIN_DEV_PORTS_FILE",
    "FORGEAX_SCENE_BACKEND_URL",
    "FORGEAX_SCENE_SCREENSHOT_NO_VISION",
    "FORGEAX_ASSET2D_BACKEND_URL",
    "FORGEAX_PROJECT_ROOT",
    "AW_SUPPORT_RUNS_DIR"
  ],
  "entry": {
    "frontend": "./frontend/dist/index.html",
    "backend": "./backend/src/tool-handlers.ts",
    "standalone": {
      "start": "bun run serve",
      "port": 9555,
      "readyProbe": "/",
      "embeddedAlso": false
    }
  },
  "experimental": true,
  "categories": [
    "workbench"
  ],
  "contributes": {
    "panelTypes": [
      {
        "id": "wb-scene-generator.content",
        "runtime": "iframe",
        "entry": "./frontend/dist/index.html"
      }
    ],
    "pages": [
      {
        "id": "wb-scene-generator",
        "title": {
          "zh": "场景生成器",
          "en": "Scene Generator"
        },
        "icon": "🌍",
        "cardinality": "singleton",
        "restorePolicy": "project",
        "layout": {
          "version": 2,
          "root": {
            "kind": "split",
            "direction": "horizontal",
            "sizes": [
              280,
              840
            ],
            "children": [
              {
                "kind": "tabs",
                "placements": [
                  "sidebar"
                ],
                "active": "sidebar"
              },
              {
                "kind": "tabs",
                "placements": [
                  "workspace"
                ],
                "active": "workspace"
              }
            ]
          }
        },
        "layoutVersion": 2,
        "panels": [
          {
            "id": "sidebar",
            "panelType": {
              "extension": "self",
              "id": "wb-scene-generator.content"
            },
            "initialProps": {
              "pane": "left",
              "minWidth": 280,
              "scrollable": true
            }
          },
          {
            "id": "workspace",
            "panelType": {
              "extension": "self",
              "id": "wb-scene-generator.content"
            },
            "initialProps": {
              "pane": "center",
              "minHeight": 600,
              "scrollable": false
            }
          }
        ],
        "matchProduces": [
          "**/scene/**/*.scene.ts",
          "**/scene-model.json",
          "**/scenes/**.scene.json"
        ],
        "preferredAgent": "sino"
      }
    ],
    "activities": [
      {
        "id": "wb-scene-generator.launcher",
        "title": {
          "zh": "场景生成器",
          "en": "Scene Generator"
        },
        "icon": "🌍",
        "category": "workbench",
        "pageType": {
          "extension": "self",
          "id": "wb-scene-generator"
        }
      }
    ],
    "skills": [
      {
        "id": "wb-scene-generator:author-guide",
        "entry": "./SKILL.md",
        "trigger": "/wb-scene-generator",
        "displayName": {
          "zh": "Scene Generator · Sino 路由指引",
          "en": "Scene Generator · Sino Routing Guide"
        },
        "description": {
          "zh": "当用户要求生成或修改完整场景、关卡、城市、地形、道路、街区、动线、空间布局、可玩区域或 skyline 布局时使用。先确认 sino 在 roster 中，再通过 delegate_to_subagent 委派给 sino；不要由 Forge 自写 SceneAsset pack，也不要因 low-poly 风格误派 lowpoly。只有用户明确要求独立可复用 .glb 模型资产时才不走 Sino。",
          "en": "Use for any request to create or revise a complete scene, level, city, terrain, roads, districts, circulation, spatial layout, playable area, or skyline layout. Confirm sino in the roster, then delegate via delegate_to_subagent. Forge must not substitute a SceneAsset pack or route to lowpoly merely because the style is low-poly. Bypass Sino only when the user explicitly requests standalone reusable .glb model assets."
        }
      },
      {
        "id": "compose-scene-script",
        "entry": "./skills/compose-scene-script/SKILL.md",
        "trigger": "/compose-scene-script",
        "displayName": {
          "zh": "Sino · Scene Script 场景设计",
          "en": "Sino · Scene Script Design"
        },
        "description": {
          "zh": "Sino 的完整场景创作与迭代技能：通过 Scene Script、专业生成算法、结构化验证和 Renderer 证据设计城市、关卡、地形、道路及空间布局。",
          "en": "Sino's complete-scene authoring and iteration skill for cities, levels, terrain, roads, and spatial layouts using Scene Script, professional generation algorithms, structured validation, and Renderer evidence."
        }
      }
    ],
    "tools": [
      {
        "id": "scene:projects.list",
        "args": {
          "type": "object",
          "additionalProperties": false
        },
        "returns": {
          "type": "array"
        },
        "exposedToAI": true,
        "description": {
          "zh": "列出当前 active game 的 Scene Generator 项目",
          "en": "List Scene Generator projects for the current active game"
        }
      },
      {
        "id": "scene:projects.create",
        "args": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "description": "可选；缺省时使用当前 active game 的默认场景名 / optional; defaults from the active game"
            },
            "type": {
              "type": "string"
            },
            "description": {
              "type": "string"
            },
            "fromTemplate": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "returns": {
          "type": "object"
        },
        "exposedToAI": true,
        "description": {
          "zh": "在当前 active game 中创建空 Scene Project 并返回项目 id；name 可省略。不打开、不初始化、不执行场景；不接受 gameSlug。",
          "en": "Create an empty Scene Project in the current active game and return its id; name is optional. This does not open, initialize, or execute the scene, and gameSlug is not accepted."
        }
      },
      {
        "id": "scene:projects.open",
        "args": {
          "type": "object",
          "required": [
            "id"
          ],
          "properties": {
            "id": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "returns": {
          "type": "object"
        },
        "exposedToAI": true,
        "description": {
          "zh": "打开指定 Scene Project 并建立当前 Sino 会话上下文；实际写入由 Scene Script 事务获取独占锁。",
          "en": "Open a Scene Project for the current Sino session; Scene Script transactions acquire the exclusive write lock when needed."
        }
      },
      {
        "id": "scene:projects.close",
        "args": {
          "type": "object",
          "required": [
            "id"
          ],
          "properties": {
            "id": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "returns": {
          "type": "object"
        },
        "exposedToAI": true,
        "description": {
          "zh": "关闭/释放对指定 Scene Generator 项目的独占锁；释放后才能打开另一个项目。释放后锁会立刻移交给排队队列里的下一个 agent（如果有的话）。",
          "en": "Close/release the exclusive lock on a Scene Generator project; required before opening another. On release the lock is handed immediately to the next agent in that project's wait queue, if any."
        }
      },
      {
        "id": "scene:projects.heartbeat",
        "args": {
          "type": "object",
          "required": [
            "id"
          ],
          "properties": {
            "id": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "returns": {
          "type": "object"
        },
        "exposedToAI": false,
        "description": {
          "zh": "续期当前会话已持有的 Scene Project 写入锁；正常 Scene Script 事务会自动续期。",
          "en": "Renew the current session's Scene Project write lease; normal Scene Script transactions renew it automatically."
        }
      },
      {
        "id": "scene:projects.queue.status",
        "args": {
          "type": "object",
          "required": [
            "id"
          ],
          "properties": {
            "id": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "returns": {
          "type": "object"
        },
        "exposedToAI": false,
        "description": {
          "zh": "查询指定项目当前的排队情况（FIFO，position=1 表示下一个轮到）。只读，不会把你加入队列——加入队列要调用 scene:projects.open。",
          "en": "Inspect a project's current FIFO wait queue (position 1 = next in line). Read-only — does NOT join the queue; call scene:projects.open to do that."
        }
      },
      {
        "id": "scene:projects.queue.leave",
        "args": {
          "type": "object",
          "required": [
            "id"
          ],
          "properties": {
            "id": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "returns": {
          "type": "object"
        },
        "exposedToAI": false,
        "description": {
          "zh": "主动退出指定项目的排队队列（例如你决定改去处理别的项目）。幂等；未排队时调用无副作用。",
          "en": "Voluntarily leave a project's wait queue (e.g. you decided to work on a different project instead). Idempotent; a no-op if you weren't queued."
        }
      },
      {
        "id": "scene:projects.remove",
        "args": {
          "type": "object",
          "required": [
            "id"
          ],
          "properties": {
            "id": {
              "type": "string"
            },
            "assetPolicy": {
              "type": "string",
              "enum": [
                "detach",
                "delete"
              ]
            }
          },
          "additionalProperties": false
        },
        "returns": {
          "type": "object"
        },
        "exposedToAI": false,
        "requireConfirm": "destructive",
        "confirmMessage": {
          "zh": "删除 Scene Generator 项目需要确认",
          "en": "Deleting a Scene Generator project requires confirmation"
        },
        "description": {
          "zh": "删除指定 Scene Generator 项目",
          "en": "Remove a Scene Generator project"
        }
      },
      {
        "id": "scene:script.contracts",
        "args": {
          "type": "object",
          "properties": {
            "projectId": { "type": "string" },
            "mode": {
              "type": "string",
              "enum": ["summary", "detail"],
              "default": "summary"
            },
            "functionNames": {
              "type": "array",
              "maxItems": 6,
              "items": { "type": "string" }
            }
          },
          "additionalProperties": false
        },
        "returns": { "type": "object" },
        "exposedToAI": true,
        "description": {
          "zh": "渐进式读取 Sino 当前代码优先架构可用的 Scene Contract：组合原语、米制空间原语和项目 Generator。选定调用后用 detail + 最多 6 个精确 functionNames 读取签名；禁止用 validate 猜函数。",
          "en": "Progressively disclose Sino's current code-first Scene Contracts: composition primitives, metre-space primitives, and project Generators. After selecting calls, use detail with at most 6 exact functionNames; never use validate for discovery."
        }
      },
      {
        "id": "scene:script.get",
        "args": {
          "type": "object",
          "properties": {
            "projectId": { "type": "string" },
            "file": { "type": "string" }
          },
          "additionalProperties": false
        },
        "returns": { "type": "object" },
        "exposedToAI": true,
        "description": {
          "zh": "读取场景源码、源码修订号和 Source Map 状态。",
          "en": "Read Scene Script source, its revision, and source-map state."
        }
      },
      {
        "id": "scene:script.validate",
        "args": {
          "type": "object",
          "required": ["source"],
          "properties": {
            "projectId": { "type": "string" },
            "file": { "type": "string" },
            "source": { "type": "string" }
          },
          "additionalProperties": false
        },
        "returns": { "type": "object" },
        "exposedToAI": true,
        "description": {
          "zh": "只解析、类型检查和编译 Scene Script，不修改项目。",
          "en": "Parse, type-check, and compile Scene Script without mutating the project."
        }
      },
      {
        "id": "scene:script.put",
        "args": {
          "type": "object",
          "required": ["source"],
          "properties": {
            "projectId": { "type": "string" },
            "file": { "type": "string" },
            "source": { "type": "string" },
            "expectedRevision": { "type": "string" },
            "canonicalize": { "type": "boolean" },
            "label": { "type": "string" }
          },
          "additionalProperties": false
        },
        "returns": { "type": "object" },
        "exposedToAI": true,
        "description": {
          "zh": "以单次源码事务更新场景；成功后节点图、预览和 Source Map 同步刷新。",
          "en": "Commit one Scene Script transaction and refresh the projected graph, preview, and source map."
        }
      },
      {
        "id": "scene:script.references",
        "args": {
          "type": "object",
          "required": ["topic"],
          "properties": {
            "projectId": { "type": "string" },
            "topic": {
              "type": "string",
              "enum": ["terrain", "districts", "roads", "parcels", "buildings", "dressing"]
            }
          },
          "additionalProperties": false
        },
        "returns": { "type": "object" },
        "exposedToAI": true,
        "description": {
          "zh": "按主题读取 Coastal Small City 的有界参考源码、依赖和输入输出，禁止整份 demo 灌入上下文。",
          "en": "Read a bounded Coastal Small City reference topic: source excerpts, dependencies, and I/O. Do not dump the whole demo."
        }
      },
      {
        "id": "scene:script.scaffold",
        "args": {
          "type": "object",
          "required": ["expectedProjectRevision"],
          "properties": {
            "projectId": { "type": "string" },
            "template": { "type": "string", "enum": ["minimal-terrain"] },
            "expectedProjectRevision": { "type": "string" },
            "overwrite": { "type": "boolean" }
          },
          "additionalProperties": false
        },
        "returns": { "type": "object" },
        "exposedToAI": true,
        "description": {
          "en": "Create a closed minimal terrain starter in an empty Scene Project and return its source files and next revision. Use it to learn the exact Generator and scene syntax; do not guess with validate. Existing authored source is preserved unless overwrite is explicitly requested."
        }
      },
      {
        "id": "scene:script.verify",
        "args": {
          "type": "object",
          "properties": { "projectId": { "type": "string" } },
          "additionalProperties": false
        },
        "returns": { "type": "object" },
        "exposedToAI": true,
        "description": {
          "en": "Read revision-bound Scene completion evidence, including execution and Renderer alignment. Verify after commitProject before reporting the scene complete."
        }
      },
      {
        "id": "scene:script.commitProject",
        "args": {
          "type": "object",
          "required": ["files"],
          "properties": {
            "projectId": { "type": "string" },
            "entryFile": { "type": "string" },
            "expectedProjectRevision": { "type": "string" },
            "expectedRevision": { "type": "string" },
            "canonicalize": { "type": "boolean" },
            "label": { "type": "string" },
            "files": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["file", "source"],
                "properties": {
                  "file": { "type": "string" },
                  "source": { "type": "string" }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        },
        "returns": { "type": "object" },
        "exposedToAI": true,
        "description": {
          "zh": "原子提交多个 Scene Script / Generator 文件，然后立即执行该 project revision，并返回 revision 绑定的执行与预览证据。",
          "en": "Atomically commit multiple Scene Script/Generator files, execute that exact project revision, and return revision-bound execution and preview evidence."
        }
      },
      {
        "id": "scene:authoring.lens",
        "args": {
          "type": "object",
          "properties": {
            "projectId": { "type": "string" },
            "file": { "type": "string" },
            "statementId": { "type": "string" },
            "entityId": { "type": "string" }
          },
          "anyOf": [
            { "required": ["statementId"] },
            { "required": ["entityId"] }
          ],
          "additionalProperties": false
        },
        "returns": { "type": "object" },
        "exposedToAI": false,
        "description": {
          "zh": "获取一个 Authoring Entity 及其一跳上下游、公共契约、允许动作和源码修订号。",
          "en": "Get a scoped edit lens with one-hop context, public contract, capabilities, and source revision."
        }
      },
      {
        "id": "scene:authoring.applyCommands",
        "args": {
          "type": "object",
          "required": ["expectedRevision", "commands"],
          "properties": {
            "projectId": { "type": "string" },
            "file": { "type": "string" },
            "expectedRevision": { "type": "string" },
            "label": { "type": "string" },
            "commands": {
              "type": "array",
              "items": { "type": "object" }
            }
          },
          "additionalProperties": false
        },
        "returns": { "type": "object" },
        "exposedToAI": false,
        "description": {
          "zh": "对 Edit Lens 范围内的 Authoring Entity 应用结构化命令；Agent 无法修改密封模板/组内部拓扑。",
          "en": "Apply scoped Authoring Entity commands; sealed template/group internals are capability-protected."
        }
      },
      {
        "id": "scene:agent.resumeSceneWork",
        "args": {
          "type": "object",
          "properties": {
            "projectId": { "type": "string" }
          },
          "additionalProperties": false
        },
        "returns": { "type": "object" },
        "exposedToAI": true,
        "description": {
          "zh": "恢复当前 Scene Project 的有界工作上下文、checkpoint 和未完成事务。",
          "en": "Resume the bounded work context, checkpoint, and unfinished transaction for the current Scene Project."
        }
      },
      {
        "id": "scene:agent.locateSceneTarget",
        "args": {
          "type": "object",
          "properties": {
            "projectId": { "type": "string" },
            "query": { "type": "string" },
            "selection": { "type": "object" },
            "authoringId": { "type": "string" },
            "sceneNodeId": { "type": "string" },
            "path": { "type": "string" },
            "semanticAddress": { "type": "string" }
          },
          "additionalProperties": false
        },
        "returns": { "type": "object" },
        "exposedToAI": true,
        "description": {
          "zh": "按 UI 选择、稳定语义地址、Scene 节点/路径与查询证据排序定位目标；歧义时要求澄清。",
          "en": "Resolve scene targets from ranked selection, semantic-address, lineage, and query evidence; ambiguity requires clarification."
        }
      },
      {
        "id": "scene:agent.openEditLens",
        "args": {
          "type": "object",
          "required": ["targetIds"],
          "properties": {
            "projectId": { "type": "string" },
            "targetIds": { "type": "array", "items": { "type": "string" } },
            "radius": { "type": "number" },
            "concerns": { "type": "array", "items": { "type": "string" } },
            "expansionReason": { "type": "string" }
          },
          "additionalProperties": false
        },
        "returns": { "type": "object" },
        "exposedToAI": true,
        "description": {
          "zh": "打开有界 Edit Lens；只含目标源码、一跳依赖/消费者、空间摘要、不变量和写范围，不返回完整 Runtime/DataTree。",
          "en": "Open a bounded edit lens without full Runtime Graph or DataTree payloads."
        }
      },
      {
        "id": "scene:agent.proposeSceneEdit",
        "args": {
          "type": "object",
          "required": ["intent", "targetIds", "commands"],
          "properties": {
            "projectId": { "type": "string" },
            "intent": { "type": "string" },
            "targetIds": { "type": "array", "items": { "type": "string" } },
            "writableModuleIds": { "type": "array", "items": { "type": "string" } },
            "preconditions": { "type": "array", "items": { "type": "object" } },
            "commands": { "type": "array", "items": { "type": "object" } },
            "expectedSemanticDelta": { "type": "array", "items": { "type": "object" } },
            "verificationProfile": { "type": "string", "enum": ["local", "global"] }
          },
          "additionalProperties": false
        },
        "returns": { "type": "object" },
        "exposedToAI": true,
        "description": {
          "zh": "创建持久、可回滚、带修订和写范围的 Scene Edit Transaction。",
          "en": "Create a persistent rollback-safe scoped Scene Edit Transaction."
        }
      },
      {
        "id": "scene:agent.applySceneEdit",
        "args": {
          "type": "object",
          "required": ["transactionId"],
          "properties": {
            "projectId": { "type": "string" },
            "transactionId": { "type": "string" },
            "humanApproved": { "type": "boolean" },
            "layout": {
              "type": "object",
              "additionalProperties": true,
              "description": "Optional bounded Layout checkpoint payload: layoutDelta, sceneDigest, probeDigest, reportDigest, capsuleDigest, and/or capsule."
            }
          },
          "additionalProperties": false
        },
        "returns": { "type": "object" },
        "exposedToAI": true,
        "description": {
          "zh": "校验修订、scope、前置条件与 Human Gate 后应用事务；实际语义差异不符则回滚。",
          "en": "Apply after revision, scope, precondition, and human-gate checks; mismatched semantic delta rolls back."
        }
      },
      {
        "id": "scene:agent.previewSemanticDiff",
        "args": {
          "type": "object",
          "required": ["transactionId"],
          "properties": {
            "projectId": { "type": "string" },
            "transactionId": { "type": "string" }
          },
          "additionalProperties": false
        },
        "returns": { "type": "object" },
        "exposedToAI": true,
        "description": {
          "zh": "预览有界 Semantic Diff 与直接修改、重编译、重执行、重验证、未变化影响分类。",
          "en": "Preview bounded semantic diff and impact classifications."
        }
      },
