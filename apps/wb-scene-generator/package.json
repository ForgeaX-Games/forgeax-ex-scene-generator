{
  "name": "@forgeax-plugin/wb-scene-generator",
  "version": "0.2.5",
  "private": true,
  "description": "Scene Generator — ForgeaX node-programming plugin built on @forgeax/node-runtime",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ForgeaX-Games/forgeax-ex-scene-generator.git"
  },
  "engines": {
    "node": ">=20.19"
  },
  "packageManager": "bun@1.3.14",
  "scripts": {
    "lint": "bun run lint:native-scene-catalog && bun run lint:scene-inventory",
    "test:serve": "node --test scripts/serve-dist.test.mjs",
    "hygiene": "node ../../scripts/hygiene-check.mjs",
    "accept": "node scripts/acceptance-loop.mjs",
    "import:assets": "node scripts/import-exported-assets.mjs",
    "build:vendor": "node scripts/build-vendor.mjs",
    "smoke": "node scripts/smoke.mjs",
    "smoke:batteries": "node scripts/smoke-batteries.mjs",
    "lint:battery-purity": "node scripts/lint-battery-purity.mjs",
    "smoke:bridge": "tsx scripts/smoke-bridge.mjs",
    "smoke:render": "tsx scripts/smoke-render.mjs",
    "smoke:assets": "tsx scripts/smoke-assets.mjs",
    "smoke:livesync": "tsx scripts/smoke-livesync.mjs",
    "smoke:history": "tsx scripts/smoke-history.mjs",
    "smoke:import": "tsx scripts/smoke-import.mjs",
    "smoke:undo": "tsx scripts/smoke-undo.mjs",
    "smoke:projects": "tsx scripts/smoke-projects.mjs",
    "smoke:assembly": "tsx scripts/smoke-scene-assembly.mjs",
    "smoke:scene-script": "tsx scripts/smoke-scene-script.mts",
    "generate:native-groups": "tsx scripts/generate-native-group-definitions.mts",
    "verify:native-groups": "tsx scripts/verify-native-group-parity.mts",
    "lint:scene-contract-coverage": "tsx scripts/lint-contract-coverage.mts",
    "generate:scene-contracts": "tsx scripts/scaffold-atomic-contracts.mts",
    "generate:scene-inventory": "node scripts/generate-scene-script-battery-inventory.mjs",
    "lint:scene-inventory": "node scripts/generate-scene-script-battery-inventory.mjs --check",
    "lint:native-scene-catalog": "node scripts/lint-native-scene-catalog.mjs",
    "acceptance:scene": "tsx scripts/scene-acceptance/run.mts",
    "acceptance:promote": "node scripts/scene-acceptance/promote.mjs",
    "acceptance:visual:projects": "tsx scripts/scene-acceptance/generate-visual-projects.mts",
    "acceptance:visual": "bun run acceptance:visual:projects && node scripts/scene-acceptance/visual-gate.mjs",
    "test:scene-acceptance": "tsx --test scripts/scene-acceptance/runner.test.mjs scripts/scene-acceptance/execute-gate.test.mts",
    "verify:scene-script": "bun run lint && bun run lint:scene-contract-coverage && bun run verify:native-groups && bun run test:scene-acceptance && bun run acceptance:scene --checkpoint acceptance/.checkpoints/ci-414.json",
    "preview": "tsx scripts/preview.mjs",
    "crop-screenshot": "tsx scripts/crop-to-content.mjs",
    "north-star": "tsx scripts/north-star-loop.mjs",
    "dev": "node scripts/dev.mjs",
    "serve": "node scripts/serve-dist.mjs"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "playwright": "1.60.0",
    "prettier": "^3.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "jszip": "^3.10.1"
  }
}
