      "label": "控制点",
      "description": "控制点坐标列表。",
      "description-en": "List of point2d control coordinates."
    }
  ],
  "outputs": [
    {
      "name": "points",
      "type": "point2d",
      "access": "list",
      "label": "控制点",
      "description": "归一化后的点列。",
      "description-en": "The normalized point2d list."
    },
    {
      "name": "count",
      "type": "number",
      "access": "item",
      "label": "点数",
      "description": "控制点数量。",
      "description-en": "Number of control points."
    }
  ]
