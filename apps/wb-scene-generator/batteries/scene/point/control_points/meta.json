{
  "id": "control_points",
  "label": "控制点列",
  "name-en": "ControlPoints",
  "description": "输入一组二维控制点列表，作为场景级几何参数一等值输出。",
  "description-en": "Accepts a list of 2D control points as a first-class scene Control Surface parameter.",
  "version": "1.0.0",
  "autoIterate": true,
  "tags": ["point2d", "control", "points", "scene", "spline"],
