{
  "id": "sample_height",
  "label": "采样高度",
  "name-en": "SampleHeight",
  "description": "在高度场上采样一组 point2d 的层高，供白盒贴地。",
  "description-en": "Sample a height grid at point2d locations so boxes sit on the hillside.",
  "version": "1.0.0",
  "tags": ["scene", "bridge", "height", "houses"],
