{
  "id": "spline_sample",
  "label": "样条采样",
  "name-en": "SplineSample",
  "description": "将控制点列采样为密点中线，并输出切线与沿弧长宽度。曲线先作为值存在，再交给扫掠或光栅化。",
  "description-en": "Sample control points into a dense centerline with tangents and per-sample widths. Curve is a value first.",
  "version": "1.0.0",
  "tags": ["scene", "bridge", "road", "curve"],
  "inputs": [
    { "name": "points", "type": "point2d", "access": "list", "required": true, "label": "控制点" },
    { "name": "roadWidth", "type": "number", "access": "item", "defaultValue": 3, "mode": "parameter", "control": true, "label": "路宽" },
    { "name": "widths", "type": "number", "access": "list", "label": "宽度剖面" },
    { "name": "flareStart", "type": "number", "access": "item", "defaultValue": 0, "mode": "parameter", "label": "起点加宽" },
    { "name": "tension", "type": "number", "access": "item", "defaultValue": 0, "mode": "parameter", "label": "张力" },
    { "name": "roundness", "type": "number", "access": "item", "defaultValue": 1.3, "mode": "parameter", "label": "圆滑" },
    { "name": "samplesPerSegment", "type": "number", "access": "item", "defaultValue": 24, "mode": "parameter", "label": "每段采样" }
  ],
  "outputs": [
    { "name": "points", "type": "point2d", "access": "list", "label": "中线点" },
    { "name": "tangents", "type": "point2d", "access": "list", "label": "切线" },
    { "name": "yaw", "type": "number", "access": "list", "label": "朝向" },
    { "name": "widths", "type": "number", "access": "list", "label": "宽度" },
    { "name": "count", "type": "number", "access": "item", "label": "点数" },
    { "name": "length", "type": "number", "access": "item", "label": "弧长" }
  ]
}
