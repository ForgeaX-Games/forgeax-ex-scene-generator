{
  "id": "landmark_watchtower",
  "label": "中心钟楼瞭望塔",
  "name-en": "LandmarkWatchtower",
  "description": "程序化生成山谷聚落核心地标钟楼/瞭望塔，包含石砌收分基座、箭孔塔身、悬挑木构外廊与四角尖顶。",
  "description-en": "Procedurally generate a village landmark watchtower/bell tower with battered stone plinth, shaft with slit windows, cantilevered timber gallery, and spire roof.",
  "version": "1.0.0",
  "tags": ["scene", "bridge", "structure", "landmark", "architecture"],
  "inputs": [
    { "name": "position", "type": "point2d", "access": "item", "required": true, "label": "塔楼位置" },
    { "name": "heightGrid", "type": "grid", "access": "item", "label": "高度场" },
    { "name": "baseSize", "type": "number", "access": "item", "defaultValue": 4.4, "mode": "parameter", "label": "基座尺寸" },
    { "name": "height", "type": "number", "access": "item", "defaultValue": 14.5, "mode": "parameter", "control": true, "label": "塔楼总高" },
    { "name": "yaw", "type": "number", "access": "item", "defaultValue": 0, "mode": "parameter", "label": "朝向" }
  ],
  "outputs": [
    { "name": "mesh", "type": "mesh", "access": "item", "label": "塔楼Mesh" },
    { "name": "triangleCount", "type": "number", "access": "item", "label": "三角面数" }
  ]
}
