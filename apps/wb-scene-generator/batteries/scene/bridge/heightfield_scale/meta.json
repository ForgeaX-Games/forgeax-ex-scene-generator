{
  "id": "heightfield_scale",
  "label": "高程缩放",
  "name-en": "HeightfieldScale",
  "description": "将等高带或离散高度网格缩放并平滑为真实海拔高度场，赋予山谷垂直落差与自然坡度。",
  "description-en": "Scale and smooth discrete contour levels into continuous elevation heightfield with realistic vertical scale.",
  "version": "1.0.0",
  "tags": ["scene", "bridge", "terrain", "heightfield"],
  "inputs": [
    { "name": "grid", "type": "grid", "access": "item", "required": true, "label": "输入网格" },
    { "name": "scale", "type": "number", "access": "item", "defaultValue": 3.2, "mode": "parameter", "control": true, "label": "高程倍率" },
    { "name": "base", "type": "number", "access": "item", "defaultValue": 0, "mode": "parameter", "control": true, "label": "基底海拔" },
    { "name": "smooth", "type": "boolean", "access": "item", "defaultValue": true, "mode": "parameter", "label": "高斯平滑" },
    { "name": "exponent", "type": "number", "access": "item", "defaultValue": 1.0, "mode": "parameter", "label": "山脊指数" }
  ],
  "outputs": [
    { "name": "heightGrid", "type": "grid", "access": "item", "label": "高度场" },
    { "name": "minElevation", "type": "number", "access": "item", "label": "最低海拔" },
    { "name": "maxElevation", "type": "number", "access": "item", "label": "最高海拔" }
  ]
}
