{
  "id": "points_to_node",
  "label": "点列→场景节点",
  "name-en": "PointsToNode",
  "description": "把 point2d 列表挂成 guide 节点（content.schema='points'）。",
  "description-en": "Hang a point2d list as a guide node (content.schema='points').",
  "version": "1.1.0",
  "tags": ["scene", "bridge", "points", "guide"],
  "inputs": [
    { "name": "name", "type": "string", "access": "item", "required": true, "label": "节点名" },
    { "name": "points", "type": "point2d", "access": "list", "required": true, "label": "点列" },
    { "name": "style", "type": "string", "access": "item", "required": false, "label": "样式" }
  ],
  "outputs": [
    { "name": "scene", "type": "scene", "access": "item", "label": "scene" },
    { "name": "points", "type": "point2d", "access": "list", "label": "点列" },
    { "name": "pointCount", "type": "number", "access": "item", "label": "点数" }
  ]
}
