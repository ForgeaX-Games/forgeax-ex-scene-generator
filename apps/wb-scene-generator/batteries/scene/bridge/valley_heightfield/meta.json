{
  "id": "valley_heightfield",
  "label": "山谷高程场",
  "name-en": "ValleyHeightfield",
  "description": "程序化生成具有开阔平缓谷底、冰川河床下切、阶梯农耕台地与两侧挺拔山脊的自然山谷连续高程场与片区掩码。",
  "description-en": "Procedurally generate a continuous mountain valley elevation heightfield with a gentle meadow floor, carved riverbed, terraced slopes and flanking alpine ridges.",
  "version": "1.2.0",
  "tags": ["scene", "bridge", "terrain", "valley"],
  "inputs": [
    { "name": "width", "type": "number", "access": "item", "defaultValue": 128, "mode": "parameter", "label": "宽度" },
    { "name": "height", "type": "number", "access": "item", "defaultValue": 128, "mode": "parameter", "label": "长度" },
    { "name": "valleyDepth", "type": "number", "access": "item", "defaultValue": 42, "mode": "parameter", "control": true, "label": "山脊落差" },
    { "name": "valleyWidth", "type": "number", "access": "item", "defaultValue": 32, "mode": "parameter", "control": true, "label": "谷底宽度" },
    { "name": "riverDepth", "type": "number", "access": "item", "defaultValue": 2.2, "mode": "parameter", "control": true, "label": "河流深度" },
    { "name": "riverWidth", "type": "number", "access": "item", "defaultValue": 8, "mode": "parameter", "control": true, "label": "河流宽度" },
    { "name": "ridgeNoise", "type": "number", "access": "item", "defaultValue": 4.6, "mode": "parameter", "control": true, "label": "山脊起伏" },
    { "name": "seed", "type": "number", "access": "item", "defaultValue": 27, "mode": "parameter", "control": true, "label": "随机种子" },
    { "name": "baseElevation", "type": "number", "access": "item", "defaultValue": 3, "mode": "parameter", "label": "谷底标高" },
    { "name": "peaks", "type": "point2d", "access": "list", "label": "语义山峰控制点" },
    { "name": "riverPoints", "type": "point2d", "access": "list", "label": "河流中心线" },
    { "name": "erosionStrength", "type": "number", "access": "item", "defaultValue": 0.7, "mode": "parameter", "label": "冲刷侵蚀强度" },
    { "name": "terraceSteps", "type": "number", "access": "item", "defaultValue": 6, "mode": "parameter", "label": "梯田台阶数" },
    { "name": "plazaCenter", "type": "point2d", "access": "item", "label": "广场中心" },
    { "name": "plazaRadius", "type": "number", "access": "item", "defaultValue": 7.4, "mode": "parameter", "label": "广场半径" }
  ],
  "outputs": [
    { "name": "heightGrid", "type": "grid", "access": "item", "label": "高度场" },
    { "name": "valleyMask", "type": "grid", "access": "item", "label": "谷底掩码" },
    { "name": "riverMask", "type": "grid", "access": "item", "label": "河流掩码" },
    { "name": "terraceMask", "type": "grid", "access": "item", "label": "梯田掩码" },
    { "name": "cliffMask", "type": "grid", "access": "item", "label": "悬崖掩码" },
    { "name": "forestMask", "type": "grid", "access": "item", "label": "森林掩码" },
    { "name": "buildableMask", "type": "grid", "access": "item", "label": "可建区域掩码" },
    { "name": "slopeGrid", "type": "grid", "access": "item", "label": "坡度场" },
    { "name": "minElevation", "type": "number", "access": "item", "label": "最低海拔" },
    { "name": "maxElevation", "type": "number", "access": "item", "label": "最高海拔" }
  ]
}
