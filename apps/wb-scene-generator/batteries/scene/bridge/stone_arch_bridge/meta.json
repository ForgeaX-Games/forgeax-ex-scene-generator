{
  "id": "stone_arch_bridge",
  "label": "石拱桥",
  "name-en": "StoneArchBridge",
  "description": "程序化生成跨越河流的石砌拱桥模型，包含桥拱、桥面铺装、桥头堡与石护栏。",
  "description-en": "Procedurally generate a stone arch bridge spanning a river, with arch soffit, paved deck, abutments, and stone parapets.",
  "version": "1.0.0",
  "tags": ["scene", "bridge", "structure", "architecture"],
  "inputs": [
    { "name": "start", "type": "point2d", "access": "item", "required": true, "label": "桥头起点" },
    { "name": "end", "type": "point2d", "access": "item", "required": true, "label": "桥头终点" },
    { "name": "heightGrid", "type": "grid", "access": "item", "label": "高度场" },
    { "name": "width", "type": "number", "access": "item", "defaultValue": 3.8, "mode": "parameter", "control": true, "label": "桥宽" },
    { "name": "archHeight", "type": "number", "access": "item", "defaultValue": 1.8, "mode": "parameter", "control": true, "label": "拱高" },
    { "name": "parapetHeight", "type": "number", "access": "item", "defaultValue": 0.85, "mode": "parameter", "label": "护栏高" }
  ],
  "outputs": [
    { "name": "mesh", "type": "mesh", "access": "item", "label": "桥梁Mesh" },
    { "name": "triangleCount", "type": "number", "access": "item", "label": "三角面数" }
  ]
}
