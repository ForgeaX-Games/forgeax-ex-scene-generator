{
  "id": "grid_to_boxes",
  "label": "地块→白盒",
  "name-en": "GridToBoxes",
  "description": "在点位上挤出轴对齐白盒子。高度来自 sample_height 或高度场，buildingHeight 只改盒子。",
  "description-en": "Extrude axis-aligned white boxes at point2d sites. Z comes from sample_height or a height grid; buildingHeight only changes the boxes.",
  "version": "1.0.0",
  "tags": ["scene", "bridge", "mesh", "houses"],
  "inputs": [
    { "name": "points", "type": "point2d", "access": "list", "required": true, "label": "宅基点" },
    { "name": "buildingHeight", "type": "number", "access": "item", "label": "房高", "default": 3 },
    { "name": "z", "type": "number", "access": "list", "label": "底面高度" },
    { "name": "heightGrid", "type": "grid", "access": "item", "label": "高度场" },
    { "name": "footprint", "type": "number", "access": "item", "label": "底面边长", "default": 2 },
    { "name": "cellSize", "type": "number", "access": "item", "label": "格尺寸", "default": 1 }
  ],
  "outputs": [
    { "name": "mesh", "type": "mesh", "access": "item", "label": "mesh" },
    { "name": "boxCount", "type": "number", "access": "item", "label": "盒子数" }
  ]
}
