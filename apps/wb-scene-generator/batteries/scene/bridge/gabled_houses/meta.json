{
  "id": "gabled_houses",
  "label": "坡顶建筑群",
  "name-en": "GabledHouses",
  "description": "在给定宅基点位生成带双坡屋顶（人字顶）与基座的白模村落建筑群，具有优美典雅的建筑体量比例。",
  "description-en": "Extrude architectural white-model village houses with gabled pitched roofs and foundation plinths at point2d sites.",
  "version": "1.0.0",
  "tags": ["scene", "bridge", "houses", "architecture"],
  "inputs": [
    { "name": "points", "type": "point2d", "access": "list", "required": true, "label": "宅基点" },
    { "name": "buildingHeight", "type": "number", "access": "item", "defaultValue": 3.2, "mode": "parameter", "control": true, "label": "建筑高度" },
    { "name": "roofHeight", "type": "number", "access": "item", "defaultValue": 1.8, "mode": "parameter", "control": true, "label": "屋顶高度" },
    { "name": "footprint", "type": "number", "access": "item", "defaultValue": 3, "mode": "parameter", "control": true, "label": "建筑面宽" },
    { "name": "depth", "type": "number", "access": "item", "defaultValue": 2.5, "mode": "parameter", "control": true, "label": "建筑进深" },
    { "name": "yaw", "type": "number", "access": "list", "label": "朝向" },
    { "name": "z", "type": "number", "access": "list", "label": "底面高度" },
    { "name": "heightGrid", "type": "grid", "access": "item", "label": "高度场" },
    { "name": "cellSize", "type": "number", "access": "item", "defaultValue": 1, "mode": "parameter", "label": "格尺寸" }
  ],
  "outputs": [
    { "name": "mesh", "type": "mesh", "access": "item", "label": "mesh" },
    { "name": "count", "type": "number", "access": "item", "label": "建筑数" }
  ]
}
