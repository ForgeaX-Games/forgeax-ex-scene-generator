{
  "id": "instantiate_placements",
  "label": "实例化布置",
  "name-en": "InstantiatePlacements",
  "description": "Instantiate prototype scenes from a PlacementSet of stable keys and local xforms.",
  "version": "1.0.0",
  "tags": ["scene", "spatial", "placement"],
  "inputs": [
    { "name": "scene", "type": "scene", "access": "item", "required": true },
    { "name": "catalog", "type": "any", "access": "item", "required": true },
    { "name": "placements", "type": "any", "access": "item", "required": true }
  ],
  "outputs": [
    { "name": "scene", "type": "scene", "access": "item" },
    { "name": "count", "type": "number", "access": "item" }
  ]
}
