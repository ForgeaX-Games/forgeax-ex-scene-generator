{
  "schemaVersion": 2,
  "id": "@forgeax-extension/scene-generator",
  "version": "0.4.3",
  "displayName": {
    "zh": "场景生成器",
    "en": "Scene Generator"
  },
  "description": {
    "zh": "由 Sino 负责的完整场景设计创作界面。适用于城市、关卡、地形、道路、街区、动线、空间布局、可玩区域与场景丰富度迭代；以 Scene Script 为创作真值、节点图为同步可视化投影。完整场景请求应派给 sino。",
    "en": "Sino's complete scene-design authoring for cities, levels, terrain, roads, districts, circulation, spatial layout, playable areas, and iterative scene enrichment. Scene Script is the authoring truth and the node graph its synchronized visual projection. Dispatch complete-scene requests to sino."
  },
  "icon": "🌍",
  "compatibleWith": {
    "forgeax-node-runtime": "^0.3.0"
  },
  "requestedEnv": [
    "FORGEAX_PLUGIN_DEV_PORTS_FILE",
    "FORGEAX_EXTENSION_DEV_PORTS_FILE",
    "FORGEAX_SCENE_BACKEND_URL",
    "FORGEAX_SCENE_SCREENSHOT_NO_VISION",
    "FORGEAX_PROJECT_ROOT",
    "AW_SUPPORT_RUNS_DIR"
  ],
  "entry": {
    "frontend": "./apps/composition/frontend/dist/index.html",
    "backend": "./apps/composition/backend/src/tool-handlers.ts",
    "standalone": {
      "start": "bun run dev",
      "port": 9555,
      "readyProbe": "/",
      "embeddedAlso": true
    }
  },
  "experimental": true,
  "categories": [
    "authoring"
  ],
  "contributes": {
    "panelTypes": [
      {
        "id": "scene-generator.content",
        "runtime": "iframe",
        "entry": "./apps/composition/frontend/dist/index.html"
      }
    ],
    "pages": [
      {
        "id": "scene-generator",
        "title": {
          "zh": "场景生成器",
          "en": "Scene Generator"
        },
        "icon": "🌍",
        "cardinality": "singleton",
        "restorePolicy": "project",
        "layout": {
          "version": 2,
          "root": {
            "kind": "split",
            "direction": "horizontal",
            "sizes": [
              280,
              840
            ],
            "children": [
              {
                "kind": "tabs",
                "placements": [
                  "sidebar"
                ],
                "active": "sidebar"
              },
              {
                "kind": "tabs",
                "placements": [
                  "workspace"
                ],
                "active": "workspace"
              }
            ]
          }
        },
        "layoutVersion": 2,
        "panels": [
          {
            "id": "sidebar",
            "panelType": {
              "extension": "self",
              "id": "scene-generator.content"
            },
            "initialProps": {
              "pane": "left",
              "minWidth": 280,
              "scrollable": true
            }
          },
          {
            "id": "workspace",
            "panelType": {
              "extension": "self",
              "id": "scene-generator.content"
            },
            "initialProps": {
              "pane": "center",
              "minHeight": 600,
              "scrollable": false
            }
          }
        ],
        "matchProduces": [
          "**/scene/**/*.scene.ts",
          "**/scene-model.json",
          "**/scenes/**.scene.json"
        ],
        "preferredAgent": "sino"
      }
    ],
    "activities": [
      {
        "id": "scene-generator.launcher",
        "title": {
          "zh": "场景生成器",
          "en": "Scene Generator"
        },
        "icon": "🌍",
        "category": "authoring",
        "pageType": {
          "extension": "self",
          "id": "scene-generator"
        }
      }
    ],
    "skills": [
      {
        "id": "scene-generator:author-guide",
        "entry": "./SKILL.md",
        "trigger": "/scene-generator",
        "displayName": {
          "zh": "Scene Generator · Sino 路由指引",
          "en": "Scene Generator · Sino Routing Guide"
        },
        "description": {
          "zh": "当用户要求生成或修改完整场景、关卡、城市、地形或空间布局时使用。先确认 sino 在 roster 中，再通过 delegate_to_subagent 委派给 sino；message 只转发用户空间需求，不要让 Sino 先读游戏 manifest、挂 SceneAsset 或探入口如何加载。地形走 basePlane / Heightfield / heightfieldExplode，站点是另一块世界米平面。不要由 Forge 自写 SceneAsset pack。",
          "en": "Use for any request to create or revise a complete scene, level, city, terrain, or spatial layout. Confirm sino in the roster, then delegate via delegate_to_subagent. Pass only the user's spatial brief; do not ask Sino to read the game manifest, attach a SceneAsset, or inspect how the entry loads. Terrain uses basePlane / Heightfield / heightfieldExplode; a site is another world-metre plane. Forge must not substitute a SceneAsset pack."
        }
      },
      {
        "id": "compose-scene-script",
        "entry": "./skills/compose-scene-script/SKILL.md",
        "trigger": "/compose-scene-script",
        "displayName": {
          "zh": "Sino · Scene Script 场景设计",
          "en": "Sino · Scene Script Design"
        },
        "description": {
          "zh": "Sino 的 Scene Script 创作技能：用 basePlane / createGrid / heightfield / heightfieldExplode 写地形，求解放在项目内 Generator，靠诊断改代码。",
          "en": "Sino's Scene Script skill: author terrain with basePlane / createGrid / heightfield / heightfieldExplode, keep solvers in a project-local Generator, and revise from diagnostics."
        }
      }
    ],
    "tools": [
      {
        "id": "scene:projects.list",
        "args": {
          "type": "object",
          "additionalProperties": false
        },
        "returns": {
          "type": "array"
        },
        "exposedToAI": true,
        "description": {
          "zh": "列出当前 active game 的 Scene Generator 项目",
          "en": "List Scene Generator projects for the current active game"
        }
      },
      {
        "id": "scene:projects.create",
        "args": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "description": "可选；缺省时使用当前 active game 的默认场景名 / optional; defaults from the active game"
            },
            "type": {
              "type": "string"
            },
            "description": {
              "type": "string"
            },
            "fromTemplate": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "returns": {
          "type": "object"
        },
        "exposedToAI": true,
        "description": {
          "zh": "在当前 active game 中创建空 Scene Project 并返回项目 id；name 可省略。不打开、不初始化、不执行场景；不接受 gameSlug。",
          "en": "Create an empty Scene Project in the current active game and return its id; name is optional. This does not open, initialize, or execute the scene, and gameSlug is not accepted."
        }
      },
      {
        "id": "scene:projects.open",
        "args": {
          "type": "object",
          "required": [
            "id"
          ],
          "properties": {
            "id": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "returns": {
          "type": "object"
        },
        "exposedToAI": true,
        "description": {
          "zh": "打开指定 Scene Project 并建立当前 Sino 会话上下文；实际写入由 Scene Script 事务获取独占锁。",
          "en": "Open a Scene Project for the current Sino session; Scene Script transactions acquire the exclusive write lock when needed."
        }
      },
      {
        "id": "scene:projects.close",
        "args": {
          "type": "object",
          "required": [
            "id"
          ],
          "properties": {
            "id": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "returns": {
          "type": "object"
        },
        "exposedToAI": true,
        "description": {
          "zh": "关闭/释放对指定 Scene Generator 项目的独占锁；释放后才能打开另一个项目。释放后锁会立刻移交给排队队列里的下一个 agent（如果有的话）。",
          "en": "Close/release the exclusive lock on a Scene Generator project; required before opening another. On release the lock is handed immediately to the next agent in that project's wait queue, if any."
        }
      },
      {
        "id": "scene:projects.heartbeat",
        "args": {
          "type": "object",
          "required": [
            "id"
          ],
          "properties": {
            "id": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "returns": {
          "type": "object"
        },
        "exposedToAI": false,
        "description": {
          "zh": "续期当前会话已持有的 Scene Project 写入锁；正常 Scene Script 事务会自动续期。",
          "en": "Renew the current session's Scene Project write lease; normal Scene Script transactions renew it automatically."
        }
      },
      {
        "id": "scene:projects.queue.status",
        "args": {
          "type": "object",
          "required": [
            "id"
          ],
          "properties": {
            "id": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "returns": {
          "type": "object"
        },
        "exposedToAI": false,
        "description": {
          "zh": "查询指定项目当前的排队情况（FIFO，position=1 表示下一个轮到）。只读，不会把你加入队列——加入队列要调用 scene:projects.open。",
          "en": "Inspect a project's current FIFO wait queue (position 1 = next in line). Read-only — does NOT join the queue; call scene:projects.open to do that."
        }
      },
      {
        "id": "scene:projects.queue.leave",
        "args": {
          "type": "object",
          "required": [
            "id"
          ],
          "properties": {
            "id": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "returns": {
          "type": "object"
        },
        "exposedToAI": false,
        "description": {
          "zh": "主动退出指定项目的排队队列（例如你决定改去处理别的项目）。幂等；未排队时调用无副作用。",
          "en": "Voluntarily leave a project's wait queue (e.g. you decided to work on a different project instead). Idempotent; a no-op if you weren't queued."
        }
      },
      {
        "id": "scene:projects.remove",
        "args": {
          "type": "object",
          "required": [
            "id"
          ],
          "properties": {
            "id": {
              "type": "string"
            },
            "assetPolicy": {
              "type": "string",
              "enum": [
                "detach",
                "delete"
              ]
            }
          },
          "additionalProperties": false
        },
        "returns": {
          "type": "object"
        },
        "exposedToAI": false,
        "requireConfirm": "destructive",
        "confirmMessage": {
          "zh": "删除 Scene Generator 项目需要确认",
          "en": "Deleting a Scene Generator project requires confirmation"
        },
        "description": {
          "zh": "删除指定 Scene Generator 项目",
          "en": "Remove a Scene Generator project"
        }
      },
      {
        "id": "scene:script.contracts",
        "args": {
          "type": "object",
          "properties": {
            "projectId": {
              "type": "string"
            },
            "mode": {
              "type": "string",
              "enum": [
                "summary",
                "detail"
              ],
              "default": "summary"
            },
            "functionNames": {
              "type": "array",
              "maxItems": 6,
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": false
        },
        "returns": {
          "type": "object"
        },
        "exposedToAI": false,
        "description": {
          "zh": "按需查询 Scene Contract。不是 Sino 工具；空项目应直接 commitProject 真实设计，不要开场读合同。",
          "en": "Look up a Scene Contract on demand. Not a Sino tool; empty projects should commitProject the actual design instead of starting with the catalog."
        }
      },
      {
        "id": "scene:script.get",
        "args": {
          "type": "object",
          "properties": {
            "projectId": {
              "type": "string"
            },
            "file": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "returns": {
          "type": "object"
        },
        "exposedToAI": true,
        "description": {
          "zh": "读取场景源码、源码修订号和 Source Map 状态。",
          "en": "Read Scene Script source, its revision, and source-map state."
        }
      },
      {
        "id": "scene:script.validate",
        "args": {
          "type": "object",
          "required": [
            "source"
          ],
          "properties": {
            "projectId": {
              "type": "string"
            },
            "file": {
              "type": "string"
            },
            "source": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "returns": {
          "type": "object"
        },
        "exposedToAI": false,
        "description": {
          "zh": "只解析、类型检查和编译 Scene Script，不修改项目。",
          "en": "Parse, type-check, and compile Scene Script without mutating the project."
        }
      },
      {
        "id": "scene:script.put",
        "args": {
          "type": "object",
          "required": [
            "source"
          ],
          "properties": {
            "projectId": {
              "type": "string"
            },
            "file": {
              "type": "string"
            },
            "source": {
              "type": "string"
            },
            "expectedRevision": {
              "type": "string"
            },
            "canonicalize": {
              "type": "boolean"
            },
            "label": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "returns": {
          "type": "object"
        },
        "exposedToAI": false,
        "description": {
          "zh": "以单次源码事务更新场景；成功后节点图、预览和 Source Map 同步刷新。",
          "en": "Commit one Scene Script transaction and refresh the projected graph, preview, and source map."
        }
      },
      {
        "id": "scene:script.draft",
        "args": {
          "type": "object",
          "required": [
            "draftId",
            "files",
            "entryFile",
            "expectedProjectRevision",
            "execute"
          ],
          "properties": {
            "projectId": {
              "type": "string"
            },
            "draftId": {
              "type": "string"
            },
            "generation": {
              "type": "integer",
              "minimum": 1
            },
            "entryFile": {
              "type": "string"
            },
            "expectedProjectRevision": {
              "type": "string"
            },
            "execute": {
              "type": "boolean"
            },
            "files": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": [
                  "file",
                  "source"
                ],
                "properties": {
                  "file": {
                    "type": "string"
                  },
                  "path": {
                    "type": "string"
                  },
                  "source": {
                    "type": "string"
                  },
                  "content": {
                    "type": "string"
                  },
                  "canonicalize": {
                    "type": "boolean"
                  }
                },
                "additionalProperties": true
              }
            }
          },
          "additionalProperties": false
        },
        "returns": {
          "type": "object"
        },
        "exposedToAI": true,
        "description": {
          "zh": "可选的试验性热预览：在隔离 runtime 中编译并执行多文件草稿，不写 canonical source/history。正常分阶段创作直接使用 commitProject；只在高风险或视觉调参时使用 draft。",
          "en": "Optional speculative hot preview: compile and execute a multi-file draft in an isolated runtime without writing canonical source/history. Normal stage-by-stage authoring commits directly; use draft only for risky or visual tuning."
        }
      },
      {
        "id": "scene:script.commitProject",
        "args": {
          "type": "object",
          "required": [
            "files"
          ],
          "properties": {
            "projectId": {
              "type": "string"
            },
            "entryFile": {
              "type": "string"
            },
            "expectedProjectRevision": {
              "type": "string"
            },
            "expectedRevision": {
              "type": "string"
            },
            "canonicalize": {
              "type": "boolean"
            },
            "label": {
              "type": "string"
            },
            "files": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "file",
                  "source"
                ],
                "properties": {
                  "file": {
                    "type": "string"
                  },
                  "path": {
                    "type": "string"
                  },
                  "source": {
                    "type": "string"
                  },
                  "content": {
                    "type": "string"
                  },
                  "canonicalize": {
                    "type": "boolean"
                  }
                },
                "additionalProperties": true
              }
            }
          },
          "additionalProperties": false
        },
        "returns": {
          "type": "object"
        },
        "exposedToAI": true,
        "description": {
          "zh": "原子提交多个 Scene Script / Generator 文件，然后立即执行该 project revision，并返回 revision 绑定的执行与预览证据。",
          "en": "Atomically commit multiple Scene Script/Generator files, execute that exact project revision, and return revision-bound execution and preview evidence."
        }
      },
      {
        "id": "scene:script.verify",
        "args": {
          "type": "object",
          "properties": {
            "projectId": {
              "type": "string"
            },
            "ifRevision": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "returns": {
          "type": "object"
        },
        "exposedToAI": true,
        "description": {
          "zh": "验证 Scene Script 源码、执行产物与 Default 可见输出（mesh / 体素 / grid）是否对齐当前 revision。不要求必须织网。",
          "en": "Verify source, artifact, execution, and Default visible output (mesh, voxel, or grid) for the current project revision. A mesh is not required."
        }
      },
      {
        "id": "scene:authoring.lens",
        "args": {
          "type": "object",
          "properties": {
            "projectId": {
              "type": "string"
            },
            "file": {
              "type": "string"
            },
            "statementId": {
              "type": "string"
            },
            "entityId": {
              "type": "string"
            }
          },
          "anyOf": [
            {
              "required": [
                "statementId"
              ]
            },
            {
              "required": [
                "entityId"
              ]
            }
          ],
          "additionalProperties": false
        },
        "returns": {
          "type": "object"
        },
        "exposedToAI": true,
        "description": {
          "zh": "获取一个 Authoring Entity 及其一跳上下游、公共契约、允许动作和源码修订号。",
          "en": "Get a scoped edit lens with one-hop context, public contract, capabilities, and source revision."
        }
      },
      {
        "id": "scene:authoring.applyCommands",
        "args": {
          "type": "object",
          "required": [
            "expectedRevision",
            "commands"
          ],
          "properties": {
            "projectId": {
              "type": "string"
            },
            "file": {
              "type": "string"
            },
            "expectedRevision": {
              "type": "string"
            },
            "label": {
              "type": "string"
            },
            "commands": {
              "type": "array",
              "items": {
                "type": "object"
              }
            }
          },
          "additionalProperties": false
        },
        "returns": {
          "type": "object"
        },
        "exposedToAI": true,
        "description": {
          "zh": "对 Edit Lens 范围内的 Authoring Entity 应用结构化命令；Agent 无法修改密封模板/组内部拓扑。",
          "en": "Apply scoped Authoring Entity commands; sealed template/group internals are capability-protected."
        }
      },
      {
        "id": "scene:batteries.list",
        "args": {
          "type": "object",
          "additionalProperties": false
        },
        "returns": {
          "type": "array"
        },
        "exposedToAI": false,
        "description": {
          "zh": "【人类/Authoring】列出第一批 scene 电池。不向 AI 暴露。",
          "en": "Human/authoring: first-batch scene battery catalog. Not exposed to AI."
        }
      },
      {
        "id": "scene:batteries.get",
        "args": {
          "type": "object",
          "required": [
            "id"
          ],
          "properties": {
            "id": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "returns": {
          "type": "object"
        },
        "exposedToAI": false,
        "description": {
          "zh": "【Authoring】读取任意 scene 电池定义。",
          "en": "Authoring access to an individual scene battery specification."
        }
      },
      {
        "id": "scene:pipeline.get",
        "args": {
          "type": "object",
          "properties": {
            "projectId": {
              "type": "string",
              "description": "目标 scene 项目 id；省略时使用 agent 已 open 的项目或 UI 当前 viewing 项目 / target scene project id; when omitted uses the agent's open project or the UI viewing project"
            },
            "raw": {
              "type": "boolean",
              "description": "true=返回完整 graph（含 params，体积大，仅 debug）；默认 false=轻量摘要 / true=full graph with params (large, debug only); default false=summary"
            },
            "mode": {
              "type": "string",
              "enum": [
                "hash",
                "summary"
              ],
              "description": "AI 默认 hash=仅 hash+节点/边计数；传 groupId/nodeIds/nameContains/opIdIn 时返回局部拓扑。summary=非筛选全图摘要，仅排障时使用 / AI defaults to hash; selectors return local topology. summary is full graph summary for diagnosis only."
            },
            "groupId": {
              "type": "string",
              "description": "只返回该组及其邻接边（instantiate 后核对用）/ scope to group neighborhood after instantiate"
            },
            "nodeIds": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "只返回这些 node 及其邻接边 / scope to listed nodes and their edges"
            },
            "nameContains": {
              "type": "string",
              "description": "grep 式模糊过滤：按节点 name **或 id** 子串（大小写不敏感）匹配。instantiate 的组常共用电池名（如 PlaceOneDecoration），应用 id 前缀查（如 p1d_）。命中节点+邻接边，附 search.matchCount（0 命中时 nodes=[]，不回退全图）。可与 groupId/nodeIds 并集。 / Fuzzy filter on node name OR id (case-insensitive). Instantiated groups often share a battery name — search by groupId prefix (e.g. p1d_). Returns matches + adjacent edges and search.matchCount (0 → empty, never full-graph fallback)."
            },
            "opIdIn": {
              "type": "array",
              "items": {
                "type": "string"
              },
